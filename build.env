# OrcaSlicer Web UI — Docker build configuration
#
# Pins the exact upstream OrcaSlicer release this image is built against.
# Consumed by both the local build (`docker build --env-file build.env` /
# docker-compose) and the GitHub Actions workflow
# (.github/workflows/docker-build.yml), so there is exactly one place to
# bump the version.
#
# ORCASLICER_VERSION
#   The upstream release tag, WITHOUT the leading "v"
#   (https://github.com/SoftFever/OrcaSlicer/releases). Used to:
#     1. Download the source tarball (src/libslic3r/PrintConfig.cpp,
#        src/slic3r/GUI/Tab.cpp) at that exact tag, so the generated
#        parameters.json / *_config_dialog_options.json snapshots always
#        match the CLI binary actually shipped in this image.
#     2. Download the matching AppImage release asset (arch-specific
#        asset name is resolved automatically inside the Dockerfile from
#        Buildx's TARGETARCH build-arg — see its stage 3 comment).
#   Example: 2.4.2
ORCASLICER_VERSION=2.4.2

# There is no ARCH variable here anymore: the image builds for whichever
# platform(s) Buildx is invoked with (`docker buildx build --platform
# linux/amd64,linux/arm64 ...` or docker-compose's default, the host
# arch). See .github/workflows/docker-build.yml for the CI matrix that
# builds and publishes both linux/amd64 and linux/arm64.
